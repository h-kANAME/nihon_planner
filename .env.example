# Google Identity (Client ID — público por diseño; también VITE_ para el front)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Whitelist de emails autorizados (coma, case-insensitive)
ALLOWED_EMAILS=emma@ejemplo.com,pareja@ejemplo.com

# Secreto para firmar cookie de sesión (≥ 32 chars)
SESSION_SECRET=cambiar-por-random-64-chars-seguro

# Cookie Secure (false en HTTP local; true detrás de HTTPS/Traefik)
COOKIE_SECURE=false

# Origen del front (CORS en dev)
FRONTEND_ORIGIN=http://localhost:5173

# AI multi-proveedor: deepseek (test) | anthropic (prod)
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=sk-...
AI_MAX_TOKENS=2048
AI_MAX_CONTINUATIONS=3

# Compactación de memoria (mensajes antes de resumir)
COMPACT_THRESHOLD=40

# DB y server
DB_PATH=/app/data/nihon.db
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Prod: servir SPA desde el mismo proceso
# SERVE_STATIC=true
# STATIC_DIR=dist
# HOST_PORT=8787
