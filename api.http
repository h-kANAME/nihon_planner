### Nihon Planner API — colección HTTP
### Base: http://localhost:8787
@base = http://localhost:8787/api/v1
@credential = PASTE_GOOGLE_ID_TOKEN_HERE

### Health (público)
GET {{base}}/../health
# o:
GET http://localhost:8787/health

### Auth — login Google
POST {{base}}/auth/google
Content-Type: application/json

{
  "credential": "{{credential}}"
}

### Auth — me
GET {{base}}/auth/me

### Auth — logout
POST {{base}}/auth/logout

### Gastos — listar
GET {{base}}/expenses

### Gastos — crear
POST {{base}}/expenses
Content-Type: application/json

{
  "description": "Ramen Ichiran",
  "amount": 1200,
  "currency": "JPY",
  "category": "comida",
  "spent_at": "2026-07-15T12:00:00.000Z"
}

### Gastos — totales
GET {{base}}/expenses/totals

### Gastos — actualizar
PUT {{base}}/expenses/ID
Content-Type: application/json

{
  "amount": 1300
}

### Gastos — borrar
DELETE {{base}}/expenses/ID

### Plan — listar
GET {{base}}/plan-items

### Plan — timeline
GET {{base}}/plan-items/timeline

### Plan — crear
POST {{base}}/plan-items
Content-Type: application/json

{
  "type": "booking",
  "title": "TeamLab Planets",
  "datetime_start": "2026-10-12T15:00",
  "meta": {}
}

### Plan — toggle done
PUT {{base}}/plan-items/ID
Content-Type: application/json

{
  "done": true
}

### Plan — borrar
DELETE {{base}}/plan-items/ID

### Rates — get
GET {{base}}/rates

### Rates — manual
PUT {{base}}/rates
Content-Type: application/json

{
  "usdArs": 1350,
  "usdJpy": 155
}

### Rates — refresh
POST {{base}}/rates/refresh

### Rates — refresh force
POST {{base}}/rates/refresh?force=true

### Sessions — listar
GET {{base}}/sessions

### Sessions — crear
POST {{base}}/sessions
Content-Type: application/json

{
  "mode": "planificar",
  "name": "Itinerario Kyoto"
}

### Sessions — chat
POST {{base}}/sessions/SESSION_ID/chat
Content-Type: application/json

{
  "content": "¿Cuántos días conviene en Kyoto?"
}

### Sessions — mensajes
GET {{base}}/sessions/SESSION_ID/messages

### Sessions — reset
POST {{base}}/sessions/SESSION_ID/reset

### Sessions — export
GET {{base}}/sessions/SESSION_ID/export

### Sessions — borrar
DELETE {{base}}/sessions/SESSION_ID

### Search FTS
GET {{base}}/search?q=kyoto

### Import artifact / localStorage dump
POST {{base}}/import
Content-Type: application/json

{
  "herramienta": "nihon-planner",
  "version": 1,
  "tipo": "planificacion",
  "sesion": {
    "id": "s1",
    "nombre": "Import test",
    "mensajes": [
      { "role": "user", "content": "hola" },
      { "role": "assistant", "content": "hola!" }
    ]
  }
}

### Backup DB
GET {{base}}/admin/backup
